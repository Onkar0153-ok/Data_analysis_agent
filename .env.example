# DataPilot AI Environment Configuration
# Copy this file to .env and configure your keys if using LLM integration

# LLM Provider Options: 'gemini', 'openai', or leave blank for deterministic fallback mode
LLM_PROVIDER=gemini

# Google Gemini API Key (Recommended for agentic function calling)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Alternative: OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Application Configuration
DATAPILOT_ENV=development
SQLITE_DB_PATH=datapilot.db
MAX_UPLOAD_SIZE_MB=50
PERSIST_DATASETS=false
